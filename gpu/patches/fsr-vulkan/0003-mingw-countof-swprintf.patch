 #ifdef __clang__
diff --git a/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp b/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
index e325a05..03e3545 100644
--- a/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
+++ b/upstream/ffx-1.1.4/sdk/src/shared/ffx_message.cpp
@@ -22,6 +22,7 @@
 
 #include <FidelityFX/host/ffx_message.h>
 #include <FidelityFX/host/ffx_util.h>
+#include <wchar.h>  // bbport: swprintf declaration on MinGW
 
 #ifdef _WIN32
 #ifndef WIN32_LEAN_AND_MEAN
@@ -48,10 +49,10 @@ void ffxPrintMessage(uint32_t type, const wchar_t* message)
         // Format the message string
         wchar_t buffer[512];
         if (type == FFX_MESSAGE_TYPE_ERROR) {
-            swprintf_s(buffer, 512, L"FSR_API_DEBUG_ERROR: %ls\n", message);
+            swprintf(buffer, 512, L"FSR_API_DEBUG_ERROR: %ls\n", message);
         }
         else if (type == FFX_MESSAGE_TYPE_WARNING) {
-            swprintf_s(buffer, 512, L"FSR_API_DEBUG_WARNING: %ls\n", message);
+            swprintf(buffer, 512, L"FSR_API_DEBUG_WARNING: %ls\n", message);
         }
         OutputDebugStringW(buffer);
     } else {
diff --git a/upstream/ffx-2.3.0/Kits/FidelityFX/api/internal/ffx_message.cpp b/upstream/ffx-2.3.0/Kits/FidelityFX/api/internal/ffx_message.cpp
